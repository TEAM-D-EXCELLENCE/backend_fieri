# ── Exemple de configuration backend FIERI ──────────────────────────
# Copier ce fichier en `.env` puis renseigner les valeurs. NE JAMAIS
# committer le `.env` réel (il est ignoré par git).

# Secret de signature des JWT (obligatoire, chaîne aléatoire longue)
JWT_SECRET=

# Chaîne de connexion PostgreSQL (Neon / local)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Passerelle de paiement (Genius Pay) ─────────────────────────────
# Base de l'API du processeur (ex: https://api.geniuspay.example)
GENIUS_PAY_API_URL=
# Clé secrète serveur (Bearer) fournie par le processeur
GENIUS_PAY_API_KEY=
# Secret partagé utilisé pour valider la signature HMAC des webhooks
GENIUS_PAY_WEBHOOK_SECRET=
# Mode démo jury : ne JAMAIS activer en production.
# Si true, les paiements sont simulés et /support/:id/confirm-mock-payment
# (protégé par JWT) devient actif.
GENIUS_PAY_MOCK=false
# Devise ISO des paiements (défaut : XOF / FCFA)
GENIUS_PAY_CURRENCY=XOF
# Nom d'en-tête HTTP portant la signature HMAC du webhook
GENIUS_PAY_SIGNATURE_HEADER=x-geniuspay-signature

# URL du frontend pour les redirections succès/annulation du paiement
FRONTEND_URL=http://localhost:5173

# ── E-mail (SMTP / Nodemailer) ──────────────────────────────────────
# Si SMTP_HOST est vide, l'envoi est ignoré (le document reste stocké).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FIERI <no-reply@fieri.local>

# ── Stockage de fichiers (PDF générés, images de signature) ─────────
# Répertoire local (relatif au cwd si non absolu) servi sous /uploads.
FILE_STORAGE_DIR=uploads
# Base des URLs publiques des fichiers générés.
PUBLIC_BASE_URL=http://localhost:3000

# ── Stockage S3-compatible (MinIO / Cloudflare R2) ──────────────────
# Si S3_BUCKET est défini, le stockage de fichiers passe en S3-compatible
# (obligatoire sur Vercel, FS éphémère) ; sinon le FS local est utilisé.
# Endpoint du service S3-compatible (optionnel — MinIO/R2)
S3_ENDPOINT=
# Région du bucket (défaut : auto, pour Cloudflare R2)
S3_REGION=auto
# Nom du bucket — vide = stockage local
S3_BUCKET=
# Identifiants d'accès S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
