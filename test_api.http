# FIERI Backend — API test collection
# Usage: replace {{host}} and {{token}} as needed.
# Default local host

# @host = http://localhost:3000
@host = https://backend-fieri.vercel.app
@token = YOUR_JWT_HERE

### Auth - Register
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "candidat@fieri.com",
  "password": "SecurePassword123!",
  "firstName": "Alexandre",
  "lastName": "Vidal",
  "branchId": 1,
  "role": "CHERCHEUR"
}

### Auth - Login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "chercheur@fieri.dev",
  "password": "MyPassword1!"
}

### Members - Me (protected)
GET {{host}}/members/me
Authorization: Bearer {{token}}

### Countries - list
GET {{host}}/countries

### Countries - get by id
GET {{host}}/countries/1

### Countries - universities by country
GET {{host}}/countries/1/universities

### Universities - branches
GET {{host}}/universities/1/branches

### University - get by id
GET {{host}}/universities/1

### Branch - get by id
GET {{host}}/branches/1

### Projects - list (optional filters)
GET {{host}}/projects

GET {{host}}/projects?clubId=club-1&status=Actif&search=Rover

### Project - details
GET {{host}}/projects/proj-101

### Project - follow/unfollow (protected)
POST {{host}}/projects/proj-101/follow
Authorization: Bearer {{token}}

### Project - support (protected)
POST {{host}}/projects/proj-101/support
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 150,
  "message": "Félicitations pour ces recherches !"
}

### Clubs - list
GET {{host}}/clubs

### Club - detail
GET {{host}}/clubs/club-1

### Club - join (protected)
POST {{host}}/clubs/club-1/join
Authorization: Bearer {{token}}

### Club - leave (protected)
DELETE {{host}}/clubs/club-1/join
Authorization: Bearer {{token}}

### Workshops - list
GET {{host}}/workshops

### Workshop - register (protected)
POST {{host}}/workshops/work-101/register
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userFullName": "Alexandre Vidal"
}

### Workshop - deregister (protected)
DELETE {{host}}/workshops/work-101/register
Authorization: Bearer {{token}}

### Events - list
GET {{host}}/events

### Event - register (protected)
POST {{host}}/events/event-101/register
Authorization: Bearer {{token}}

### Researchers - list
GET {{host}}/researchers

### Researcher - details
GET {{host}}/researchers/101

### Researcher - my profile (protected)
GET {{host}}/researchers/me
Authorization: Bearer {{token}}

### Researcher - update my profile (protected)
PUT {{host}}/researchers/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "bio": "Expert en vision artificielle.",
  "skills": ["Python", "OpenCV", "TensorFlow"],
  "avatarUrl": "https://example.com/avatar.jpg"
}

### Researcher - follow (protected)
POST {{host}}/researchers/101/follow
Authorization: Bearer {{token}}

### News - list (public, optional includePending)
GET {{host}}/news

GET {{host}}/news?includePending=true

### News - get
GET {{host}}/news/news-101

### News - create (protected)
POST {{host}}/news
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Avancées en Fusion Nucléaire",
  "content": "Corps de l'article...",
  "category": "Physique"
}

### News - approve (admin, protected)
PATCH {{host}}/news/news-101/approve
Authorization: Bearer {{token}}

### News - delete (protected)
DELETE {{host}}/news/news-101
Authorization: Bearer {{token}}

### Dashboard - my stats (protected)
GET {{host}}/dashboard/me
Authorization: Bearer {{token}}

### Notifications - list (protected)
GET {{host}}/notifications
Authorization: Bearer {{token}}

### Notifications - mark as read (protected)
PUT {{host}}/notifications/notif-101/read
Authorization: Bearer {{token}}

### Contact - submit message
POST {{host}}/contact
Content-Type: application/json

{
  "name": "Professeur Dupont",
  "email": "dupont@sorbonne.fr",
  "subject": "Partenariat R&D",
  "message": "Texte du message..."
}

### Tasks - get by project (protected)
GET {{host}}/tasks/project/proj-101
Authorization: Bearer {{token}}

### Tasks - create (protected, role CHEF_DE_PROJET/ADMIN)
POST {{host}}/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "projectId": "proj-101",
  "title": "Intégration du LiDAR",
  "status": "TODO",
  "priority": "HIGH",
  "assignedTo": "Alexandre Vidal"
}

### Tasks - update status (protected)
PUT {{host}}/tasks/task-101
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "IN_PROGRESS"
}

### Tasks - assign (protected)
PATCH {{host}}/tasks/task-101/assign
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assignedTo": "Tisto Dev"
}

### Tasks - priority (protected)
PATCH {{host}}/tasks/task-101/priority
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "priority": "MEDIUM"
}

### Tasks - delete (protected)
DELETE {{host}}/tasks/task-101
Authorization: Bearer {{token}}

### Badges - get by user
GET {{host}}/badges/user/101

### Badges - award (protected)
POST {{host}}/badges/award
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": 101,
  "userName": "Alexandre Vidal",
  "badgeType": "CONTRIBUTOR_GOLD",
  "awardedBy": "Conseil"
}

### Badges - revoke (protected)
DELETE {{host}}/badges/badge-101
Authorization: Bearer {{token}}

### Memberships - create request (protected)
POST {{host}}/memberships/requests
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clubId": "club-1"
}

### Memberships - pending requests (protected, role RESPONSABLE/ADMIN)
GET {{host}}/memberships/requests/pending/club-1
Authorization: Bearer {{token}}

### Memberships - club history (protected)
GET {{host}}/memberships/requests/club/club-1
Authorization: Bearer {{token}}

### Memberships - user requests (protected)
GET {{host}}/memberships/requests/user/101
Authorization: Bearer {{token}}

### Memberships - approve (protected, role RESPONSABLE/ADMIN)
PATCH {{host}}/memberships/requests/req-4589/approve
Authorization: Bearer {{token}}

### Memberships - reject (protected, role RESPONSABLE/ADMIN)
PATCH {{host}}/memberships/requests/req-4589/reject
Authorization: Bearer {{token}}

### Memberships - leave club (protected)
DELETE {{host}}/memberships/club-1/user/101
Authorization: Bearer {{token}}

### Applications - submit (protected)
POST {{host}}/applications
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "opportunityId": "opp-201",
  "coverLetter": "Lettre de motivation...",
  "cvUrl": "https://..."
}

### Applications - my applications (protected)
GET {{host}}/applications/my
Authorization: Bearer {{token}}

### Applications - check applied (protected)
GET {{host}}/applications/check/opp-201
Authorization: Bearer {{token}}

### Applications - get all for opportunity (protected, role CHEF_DE_PROJET/ADMIN)
GET {{host}}/applications/opportunity/opp-201
Authorization: Bearer {{token}}

### Applications - update status (protected, role CHEF_DE_PROJET/ADMIN)
PATCH {{host}}/applications/app-101/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "APPROVED"
}
